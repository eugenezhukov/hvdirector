# /etc/hvdirector/hvdirector.env  (owner root:hvdirector, mode 0640)
#
# Only bootstrap values live here.  Hyper-V host addresses and credentials, the
# ISO share, guacd address etc. are stored in PostgreSQL (credentials encrypted
# with HVD_SECRET_KEY) and managed in the provider portal.

# PostgreSQL connection
HVD_DATABASE_URL=postgresql+psycopg://hvdirector:CHANGE_ME@127.0.0.1:5432/hvdirector

# Master key for credentials stored in the database (hvdirector-manage gen-key).
# Keep a backup: without it the stored Hyper-V/share passwords cannot be decrypted.
HVD_SECRET_KEY=CHANGE_ME

# psrp = real Hyper-V over WinRM; fake = built-in simulator (demo / development)
HVD_HYPERV_DRIVER=psrp

# Cookies are marked Secure (portal must be served over HTTPS)
HVD_COOKIE_SECURE=true

HVD_LOG_LEVEL=INFO
HVD_WORKER_THREADS=8
HVD_FRONTEND_DIST=/opt/hvdirector/app/frontend/dist
